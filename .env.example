# Recommended primary provider: create a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
# Optional: override the default Groq model.
GROQ_MODEL=llama-3.3-70b-versatile
# PDF-only models: 25 requests/minute are scheduled per model.
GROQ_PDF_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_PDF_MODEL_SECONDARY=openai/gpt-oss-20b

# Optional fallback provider: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional shared server-side cache for Vercel/Netlify (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
